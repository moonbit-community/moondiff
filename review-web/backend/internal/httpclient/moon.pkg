import {
  "moonbit-community/moondiff-review-web-server/internal/httpio",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/types",
}

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/compress/gzip" ],
)

import {
  "moonbitlang/core/async/socket",
  "moonbit-community/moondiff-review-web-server/internal/protocol" @common,
} for "wbtest"
