# Replace diff.example and certificate paths. Run the Wasm service through moonrun on loopback.
server {
    listen 443 ssl;
    server_name diff.example;
    ssl_certificate /etc/letsencrypt/live/diff.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diff.example/privkey.pem;
    client_max_body_size 128k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 70s;
        # Keep Origin unchanged; the server checks it against PUBLIC_URL.
        # Do not cache /api or /auth responses, or rewrite app routes to index.html.
    }
}
