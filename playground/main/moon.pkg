import {
  "moonbit-community/moondiff/model",
  "moonbit-community/moondiff/mbtdiff",
  "moonbit-community/moondiff/internal/tokdiff",
  "moonbit-community/moondiff/internal/tokdiff/html" @tokdiff_html,
  "moonbit-community/moondiff/internal/tokdiff/text" @tokdiff_text,
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/clipboard",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/http",
  "moonbit-community/rabbita/nav",
  "moonbit-community/rabbita/sub",
  "moonbit-community/rabbita/url",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")
