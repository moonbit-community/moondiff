{
  "name": "moondiff-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix review-web run build",
    "test:review-web": "npm --prefix review-web run test:e2e",
    "test:views": "npm --prefix review-web run test:views",
    "test:review-web:stress": "npm --prefix review-web run test:e2e:stress --",
    "build:extension": "npm run build:extension:chrome && npm run build:extension:firefox",
    "build:extension:chrome": "node extension/chrome/scripts/build.mjs",
    "build:extension:firefox": "node extension/firefox/scripts/build.mjs",
    "test:extension": "npm run test:extension:chrome && npm run test:extension:firefox",
    "test:extension:unit": "node --test extension/chrome/tests/*.test.mjs extension/firefox/tests/*.test.mjs",
    "test:extension:e2e": "npm run test:extension:chrome:e2e && npm run test:extension:firefox:e2e",
    "test:extension:chrome": "node --test extension/chrome/tests/*.test.mjs && npm run test:extension:chrome:e2e --",
    "test:extension:chrome:e2e": "review-web/node_modules/.bin/playwright test --config extension/chrome/playwright.config.mjs",
    "test:extension:firefox": "node --test extension/firefox/tests/*.test.mjs && npm run test:extension:firefox:e2e --",
    "test:extension:firefox:e2e": "review-web/node_modules/.bin/playwright test --config extension/firefox/playwright.config.mjs",
    "lint:extension:firefox": "node extension/firefox/scripts/lint.mjs",
    "package:extension": "npm run package:extension:chrome && npm run package:extension:firefox",
    "package:extension:chrome": "node extension/chrome/scripts/package.mjs",
    "package:extension:firefox": "node extension/firefox/scripts/package.mjs",
    "start": "npm --prefix review-web start",
    "dev": "npm --prefix review-web run dev",
    "test:server": "npm --prefix review-web run test:server",
    "test:artifacts": "node --test review-web/tests/artifacts.test.mjs"
  }
}
